rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTeacher() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isExamOwner(examId) {
      return isTeacher() &&
        resource.data.teacherUid == request.auth.uid;
    }

    // Users Collection (Teachers)
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Exams Collection
    match /exams/{examId} {
      // Allow read for everyone so students can find the exam and verify eligibility
      allow read: if true;
      allow write: if isTeacher() && (resource == null || resource.data.teacherUid == request.auth.uid);
      
      // Questions Subcollection
      match /questions/{questionId} {
        // Students can read questions (never contains answer keys)
        allow read: if true;
        allow write: if isTeacher();
      }

      // Answer Keys Subcollection (STRICTLY TEACHER/SERVER ONLY)
      match /answerKeys/{questionId} {
        allow read, write: if isTeacher();
      }

      // Enrolled Students Subcollection
      match /students/{studentId} {
        allow read: if true; // Used by student verification
        allow write: if isTeacher();
      }
    }

    // Attempts Collection
    match /attempts/{attemptId} {
      allow read, write: if true;

      // Student individual answers
      match /answers/{questionId} {
        allow read, write: if true;
      }

      // Proctoring violations
      match /violations/{violationId} {
        allow read, write: if true;
      }
    }

    // Audit logs (Read-only for teachers)
    match /auditLogs/{logId} {
      allow read: if isTeacher();
      allow write: if false; // Server-only
    }
  }
}
